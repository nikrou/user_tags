includes:
  - phpstan-baseline.neon

parameters:
  level: 1

  bootstrapFiles:
    - phpstan.bootstrap

  paths:
    - src
    - template
    - include
    - main.inc.php
    - maintain.inc.php
    - admin.php
    - public.php

  scanDirectories:
    - ../Piwigo

  reportUnmatchedIgnoredErrors: true
